{
  "name": "dsh-usage-panel",
  "version": "0.5.5",
  "description": "服务余额与用量面板：侧边栏跨服务本月消耗汇总（账本口径，标估算）+ 各服务官方余额卡 + 可折叠账本明细（近 7 天 / 按模型 / 按会话说明），手动刷新、Key 打码、失败降级 · Service balance & usage panel for DSH Desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengnowuyu-beep/dsh-usage-panel.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/host.test.mjs && node test/p1.test.mjs && node test/p2.test.mjs && node test/p3.test.mjs && node test/p4.test.mjs && node test/client.test.mjs",
    "check:secrets": "node scripts/check-staged-secrets.mjs",
    "preview": "node preview/server.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "usage",
    "balance",
    "deepseek"
  ],
  "license": "MIT"
}
